{
  "name": "@local/dsh-nebula-spectrum",
  "version": "0.3.0",
  "description": "Nebula Spectrum — an aurora-canvas theme for the DeepSeek Harness Web UI, in eight editions: Indigo, Ember, Crimson and Neon (dark), Rainbow, Sunrise, Glacier and Rose (light).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "nebula",
    "spectrum",
    "aurora"
  ],
  "homepage": "https://github.com/LiuHongXuMaritime/dsh-nebula-spectrum#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuHongXuMaritime/dsh-nebula-spectrum.git"
  },
  "bugs": {
    "url": "https://github.com/LiuHongXuMaritime/dsh-nebula-spectrum/issues"
  },
  "author": "LiuHongXuMaritime",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "verify": "node verify.js",
    "icon": "node scripts/make-icon.mjs",
    "sync": "node scripts/sync-pi.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
